{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    "fs:allow-appdata-meta",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read",
    "fs:allow-write",
    "fs:scope-appdata",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-open"
  ]
}